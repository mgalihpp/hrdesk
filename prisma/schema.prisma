generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Tenant settings doc, keyed by the Better Auth organization id (tenantId).
model Tenant {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String   @unique
  plan            String   @default("free")
  taxLocale       String   @default("US")
  brandingName    String   @default("")
  brandingLogoUrl String   @default("")
  updatedAt       DateTime @default(now())
}

// Employee record. PII fields are AES-256-GCM ciphertext (see lib/crypto).
// compensation is integer minor units (Cents), never a float.
model Employee {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String
  firstName    String
  lastName     String
  email        String
  ssnEnc       String
  bankEnc      String
  compensation Int
  hireDate     String
  status       String   @default("active")
  createdAt    DateTime @default(now())

  @@index([tenantId])
}
